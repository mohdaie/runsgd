{
  "id": "/",
  "name": "RunSGD",
  "short_name": "RunSGD",
  "description": "Singapore ↔ Johor commute planner with live Causeway, bus and weather info",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f8fbff",
  "theme_color": "#f8fbff",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
